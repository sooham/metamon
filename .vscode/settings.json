{
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/coverage/**": true,
        "**/.cache/**": true,
        "**/.venv/**": true,
        "**/wandb/**": true,
        "**/checkpoints/**": true,
        "**/__pycache__/**": true,
        "**/*.egg-info/**": true,
        "**/.pytest_cache/**": true,
        "**/server/pokemon-showdown/**": true,
        "**/bayesian_dataset/**": true,
        "**/parsed-json-format.jsonl": true
    },
    "folder-color.pathColors": [
        {
            "folderPath": "metamon/data/",
            "color": "foldercolorizer.color_336633"
        },
        {
            "folderPath": "metamon/backend/",
            "color": "foldercolorizer.color_6666ff"
        },
        {
            "folderPath": "metamon/il/",
            "color": "foldercolorizer.color_666666"
        }
    ]
}